# Duplique como .env e preencha. Nunca versione o .env real.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo
LUNA_TTS_ENABLED=true
LUNA_TTS_VOICE=pt-BR-FranciscaNeural
# Outra voz feminina pt-BR disponível: pt-BR-FranciscaNeural

# Firebase Authentication: habilite Google e/ou e-mail/senha no console.
ALLOWED_EMAIL=voce@email.com
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Revogação imediata exige credenciais Admin; deixe false no modo local sem service account.
FIREBASE_CHECK_REVOKED=false
# Opcional. Sem isso, Firebase Admin usa ADC/GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_SERVICE_ACCOUNT=

# Banco local (pasta persistente, recomendada para Raspberry Pi)
# LUNA_DATA_DIR=./luna_data

# Busca na web (opcionais)
# Modelo do Groq que decide se a mensagem precisa de pesquisa (padrão: o mesmo de GROQ_CHAT_MODEL).
# GROQ_ROUTER_MODEL=
# Provedor da busca: ddgs (padrão, sem chave), tavily ou brave.
# LUNA_SEARCH_PROVIDER=ddgs
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# Se o provedor escolhido falhar ou não achar nada, usa o DuckDuckGo (padrão: true).
# LUNA_SEARCH_FALLBACK=true
# Motor do DDGS (padrão: auto).
# LUNA_DDGS_BACKEND=auto

# Memória de curto prazo e raciocínio (opcionais; os padrões já funcionam)
# Texto máximo do histórico enviado ao modelo (padrão: 24000 caracteres).
# LUNA_CONTEXT_CHARS=24000
# Mensagens guardadas no banco antes de serem condensadas (padrão: 400).
# LUNA_CONTEXT_ROWS=400
# Quantas mensagens acumulam antes de virarem resumo, e quantas ficam inteiras (padrão: 60 e 30).
# LUNA_SUMMARY_TRIGGER=60
# LUNA_SUMMARY_KEEP=30
# Força o esforço de raciocínio (low, medium ou high); vazio = automático.
# LUNA_REASONING_EFFORT=
# Limite de tokens por resposta, incluindo o raciocínio (padrão: 4096).
# LUNA_MAX_TOKENS=4096

# Atendimento por WhatsApp (ponte em whatsapp_bridge/). Sem o token, o endpoint fica desativado.
# LUNA_ATENDIMENTO_TOKEN=          # 24+ caracteres aleatórios; o mesmo valor vai no .env da ponte
# LUNA_DONO_NOME=                  # como a Luna se refere a você nas conversas
# LUNA_ATENDIMENTO_TOM=            # estilo extra opcional, ex.: descontraída
