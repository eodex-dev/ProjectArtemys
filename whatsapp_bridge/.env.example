# Copie para .env nesta pasta. Nunca versione o .env real.

# Evolution API (onde o WhatsApp está conectado)
EVOLUTION_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=luna

# Luna principal (a do Render). O token precisa ser igual ao LUNA_ATENDIMENTO_TOKEN do servidor.
LUNA_URL=https://seu-app.onrender.com
LUNA_ATENDIMENTO_TOKEN=

# Segredo que vai na URL do webhook (24+ caracteres aleatórios)
WEBHOOK_SECRET=

# Número que recebe os avisos e manda os comandos (#ausente, #voltei...). Só dígitos, com 55 e DDD.
CONTROL_NUMBER=5511999999999
DONO_NOME=

# Opcionais
# BRIDGE_DB=./ponte.db
# CONTATOS_FILE=./contatos.json
# DEBOUNCE_S=8
# COOLDOWN_S=20
# MAX_POR_HORA=6
# MAX_POR_DIA=20
# MAX_IDADE_S=600
# AUTO_PADRAO_MIN=10
